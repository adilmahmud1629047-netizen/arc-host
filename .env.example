# Application
NODE_ENV=development
# Client dev server port (5000 is the original FLARE project's port — never use
# it for this project; the client test server runs on 5056).
PORT=5001
API_PREFIX=/api

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
# This project's OWN database. Never `flare_hosting` — that belongs to the
# original FLARE project. Test runs must point at a separate client test DB.
DATABASE_NAME=minecraft_client
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Authentication / sessions
SESSION_COOKIE_NAME=fh_session
SESSION_TTL_SECONDS=604800

# Rate limiting
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX=10
ORDER_RATE_LIMIT_WINDOW_MS=900000
ORDER_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_WINDOW_MS=900000
PAYMENT_RATE_LIMIT_MAX=30

# Payments — sandbox only by default. Live/production card payments are
# intentionally refused.
# `disabled` rejects every payment operation with PAYMENT_PROVIDER_NOT_CONFIGURED.
# `sslcommerz` enables the SSLCommerz sandbox flow (test credentials required).
# `uddoktapay` enables the UddoktaPay redirect checkout flow (see block below).
PAYMENT_PROVIDER=disabled
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_BASE_URL=https://sandbox-gw.sslcommerz.com
SSLCOMMERZ_VALIDATION_URL=https://sandbox.sslcommerz.com/validator/api/validationserverAPI.php
# Public base URL of THIS app. Gateway success/fail/cancel/IPN URLs are built
# only from this value. Must be an externally reachable https URL for real
# IPN delivery — localhost cannot receive SSLCommerz IPN.
# Leave empty (or local) while PAYMENT_PROVIDER=disabled.
APP_PUBLIC_URL=
PAYMENT_CALLBACK_RATE_LIMIT_WINDOW_MS=60000
PAYMENT_CALLBACK_RATE_LIMIT_MAX=120
SSLCOMMERZ_CONNECT_TIMEOUT_MS=10000
SSLCOMMERZ_REQUEST_TIMEOUT_MS=15000

# UddoktaPay gateway (https://uddoktapay.readme.io). Server-side only — never
# commit a real API key, never expose it to frontend code, logs, or responses.
# UDDOKTAPAY_API_URL: API base URL of YOUR UddoktaPay installation, as shown
#   in its Dashboard / API settings (no trailing slash). Sandbox example:
#   https://sandbox.uddoktapay.com — production = your own installation URL.
# UDDOKTAPAY_API_KEY: API key from the same dashboard (header RT-UDDOKTAPAY-API-KEY).
# To activate: set PAYMENT_PROVIDER=uddoktapay AND fill both values AND set
# APP_PUBLIC_URL (callback URLs are built exclusively from it, https required
# for real gateway deliveries — localhost cannot receive gateway callbacks).
UDDOKTAPAY_API_URL=
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_CONNECT_TIMEOUT_MS=10000
UDDOKTAPAY_REQUEST_TIMEOUT_MS=15000

# bKash inbound SMS auto-verification (step 17). OFF by default — do not
# enable until real TextBee credentials + webhook delivery are verified.
# Receiver number is the payment SIM (server-side only), not the SMS sender.
BKASH_PAYMENT_ENABLED=false
BKASH_RECEIVER_NUMBER=

# SMS — TextBee gateway (https://textbee.dev/docs). Server-side only: never
# commit a real API key, never expose it to frontend code, logs, or responses.
# `disabled` (default) refuses every send with SMS_PROVIDER_NOT_CONFIGURED.
# `textbee` requires TEXTBEE_API_KEY (from https://app.textbee.dev/dashboard)
# and a paired Android device. Recipients must be E.164 (e.g. +8801712345678).
SMS_PROVIDER=disabled
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
TEXTBEE_DEVICE_ID=
TEXTBEE_GATEWAY_ID=
TEXTBEE_SIM_SUBSCRIPTION_ID=
# Incoming SMS webhook (https://textbee.dev/docs/webhooks).
# Signing secret set on the TextBee dashboard webhook subscription.
# Server-side only — never commit a real secret, never expose it anywhere.
TEXTBEE_WEBHOOK_SECRET=
TEXTBEE_WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
TEXTBEE_WEBHOOK_RATE_LIMIT_MAX=120
SMS_REQUEST_TIMEOUT_MS=10000
SMS_RATE_LIMIT_WINDOW_MS=900000
SMS_RATE_LIMIT_MAX=10

# Argon2id password hashing
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Provisioning — server-side only. `disabled` (default) refuses every
# provisioning operation with PROVISIONING_PROVIDER_NOT_CONFIGURED and never
# creates a service instance. `proxmox` / `whm` select the real provider
# (Step 12 providers refuse with PROVISIONING_NOT_IMPLEMENTED — no external
# call is made). Credentials stay in this environment file only: never commit
# real secrets, never expose them to frontend code, logs, or API responses.
PROVISIONING_PROVIDER=disabled
PROXMOX_API_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=
WHM_API_URL=
WHM_API_TOKEN=
WHM_USERNAME=

# Public plan catalog
CATALOG_CURRENCY=BDT
CATALOG_CACHE_TTL_MS=30000
